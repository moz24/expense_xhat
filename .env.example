# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Preferred currency symbol (PKR, USD, INR, etc.)
CURRENCY=PKR

# Whisper model size: tiny, base, small, medium, large
# larger = more accurate but slower. tiny is good for most use
WHISPER_MODEL_SIZE=base

# Language preference: auto (detect), en, ur (will default to auto)
PREFERRED_LANGUAGE=auto

# PostgreSQL connection string (Railway auto-injects this)
# Leave empty to fall back to SQLite for local dev
DATABASE_URL=
